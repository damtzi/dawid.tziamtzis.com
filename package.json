{
	"name": "dawid-tziamtzis-com",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"check": "astro check",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"deploy": "pnpm build && wrangler deploy --message \"$(git log -1 --pretty=%s)\"",
		"format": "oxfmt && prettier --write \"**/*.astro\"",
		"format:check": "oxfmt --check && prettier --check \"**/*.astro\"",
		"lint": "oxlint && eslint . && astro check && pnpm format:check",
		"lint:fix": "oxlint --fix && eslint . --fix",
		"lint-staged": "lint-staged",
		"prepare": "husky"
	},
	"dependencies": {
		"astro": "^7.3.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@cloudflare/workers-types": "^5.20260917.1",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.7.0",
		"eslint-plugin-oxlint": "^1.83.0",
		"eslint-plugin-unicorn": "^60.0.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.83.0",
		"prettier": "^3.9.7",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"wrangler": "^4.133.0"
	},
	"packageManager": "pnpm@11.20.0",
	"lint-staged": {
		"*.{js,jsx,ts,tsx,astro}": "oxlint --fix",
		"*.{js,jsx,ts,tsx,json,jsonc,css,md,mdx,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
		"*.astro": [
			"eslint --fix",
			"prettier --write"
		]
	}
}
