{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dawid-tziamtzis-com",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-18",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "dawid.tziamtzis.com",
			"custom_domain": true
		},
		{
			"pattern": "david.tziamtzis.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	}
}
